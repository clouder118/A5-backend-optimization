APP_ENV=dev
DATABASE_URL=sqlite:///./data/app.db
SOURCE_PACKAGE_PATH=../Scenic Area Public Information Package
DERIVED_KNOWLEDGE_PATH=../knowledge

LLM_MODE=openai_compatible
LLM_PROVIDER=mimo
LLM_BASE_URL=https://api.xiaomimimo.com/v1
LLM_API_KEY=
LLM_MODEL=mimo-v2.5

WEB_SEARCH_MODE=mimo
WEB_SEARCH_TIMEOUT_SECONDS=20.0
WEB_SEARCH_MAX_RESULTS=3

TTS_MODE=provider
TTS_PROVIDER=mimo
TTS_BASE_URL=https://api.xiaomimimo.com/v1
TTS_API_KEY=
TTS_MODEL=mimo-v2.5-tts
TTS_VOICE=mimo_default
TTS_AUDIO_FORMAT=mp3
TTS_OUTPUT_DIR=./data/tts

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175
ENABLE_ADMIN_TOKEN=false
ADMIN_TOKEN=
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=123456
AUTH_TOKEN_SECRET=dev-only-change-me
AUTH_TOKEN_TTL_SECONDS=86400
