APP_ENV=dev
DATABASE_URL=sqlite:///./data/app.db
SOURCE_PACKAGE_PATH=../Scenic Area Public Information Package
DERIVED_KNOWLEDGE_PATH=../knowledge

LLM_MODE=openai_compatible
LLM_PROVIDER=mimo
LLM_BASE_URL=https://api.xiaomimimo.com/v1
LLM_API_KEY=
LLM_MODEL=mimo-v2.5
GUIDE_STYLE=warm_real_guide
GUIDE_ROUTE_TRIGGER_STRICT=true
LLM_TEMPERATURE_FACT=0.35
LLM_TEMPERATURE_GUIDE=0.55
LLM_TEMPERATURE_SERVICE=0.65
LLM_TEMPERATURE_ROUTE=0.45
LLM_MAX_COMPLETION_TOKENS=700

# 旅行手账共创（仅服务端读取，禁止提交真实 Key）
KIMI_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_TIMEOUT_SECONDS=120
TRAVEL_JOURNAL_ASSET_DIR=./data/travel_journals

# 相册创意工坊（仅服务端读取，禁止提交真实 Key）
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_API_KEY=
SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628
SEEDREAM_TIMEOUT_SECONDS=180
PHOTO_WORKSHOP_POLISH_MODEL=mimo-v2.5-pro
PHOTO_WORKSHOP_POLISH_TIMEOUT_SECONDS=60

RAG_RETRIEVAL_MODE=hybrid
RAG_VECTOR_MODE=openai_compatible
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_API_KEY=
# 可选：也可以使用 DASHSCOPE_API_KEY=...，不要提交真实 Key
DASHSCOPE_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_TIMEOUT_SECONDS=0.8
# 演示/真实评测建议开启；pytest 环境未显式配置时会自动关闭，避免测试误连云端。
RAG_EMBEDDING_INDEX_ON_STARTUP=true
RAG_EMBEDDING_INDEX_TIMEOUT_SECONDS=8.0
RAG_EMBEDDING_INDEX_BUDGET_SECONDS=30.0
RAG_EMBEDDING_INDEX_BATCH_SIZE=8

GUIDE_WARMUP_ON_STARTUP=true
GUIDE_WARMUP_MAX_QUESTIONS=40
GUIDE_WARMUP_BUILD_ANSWER_CACHE=false
GUIDE_RETRIEVAL_CACHE_TTL_SECONDS=1800
GUIDE_RETRIEVAL_CACHE_SIZE=256
GUIDE_ANSWER_CACHE_TTL_SECONDS=1800
GUIDE_ANSWER_CACHE_SIZE=128

WEB_SEARCH_MODE=mimo
WEB_SEARCH_TIMEOUT_SECONDS=20.0
WEB_SEARCH_MAX_RESULTS=3

AMAP_KEY=
AMAP_SECURITY_CODE=

TTS_MODE=provider
TTS_PROVIDER=mimo
TTS_BASE_URL=https://api.xiaomimimo.com/v1
TTS_API_KEY=
TTS_MODEL=mimo-v2.5-tts
TTS_VOICE=mimo_default
TTS_AUDIO_FORMAT=mp3
TTS_OUTPUT_DIR=./data/tts

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175
ENABLE_ADMIN_TOKEN=false
ADMIN_TOKEN=
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=123456
AUTH_TOKEN_SECRET=dev-only-change-me
AUTH_TOKEN_TTL_SECONDS=86400
